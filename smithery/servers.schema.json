{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/academica-sh/academica-mcp/blob/main/smithery/servers.schema.json",
  "title": "Academica Smithery publication records",
  "type": "object",
  "required": [
    "servers"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "servers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "qualifiedName",
          "displayName",
          "url"
        ],
        "properties": {
          "qualifiedName": {
            "type": "string",
            "pattern": "^@academica/[a-z0-9-]+$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://academica\\.sh/api/mcp/"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
